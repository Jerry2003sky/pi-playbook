{
  "lastChangelogVersion": "0.85.0",
  "theme": "dark",
  "defaultProvider": "zai-coding-cn",
  "defaultModel": "glm-5.3",
  "defaultThinkingLevel": "xhigh",
  "defaultTools": [
    "find",
    "grep",
    "bash",
    "read",
    "edit",
    "write",
    "ls"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-context-view",
    "npm:pi-cache-graph",
    "npm:@ff-labs/pi-fff",
    "npm:pi-claude-code-ui",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-token-speed",
    "npm:pi-condense",
    "npm:pi-autoname",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "enabledModels": [
    "deepseek/deepseek-v4-flash",
    "deepseek/deepseek-v4-pro",
    "fireworks/accounts/fireworks/models/qwen3p8-max",
    "kimi-coding/k3",
    "kimi-coding/k3-256k",
    "kimi-coding/kimi-for-coding-highspeed",
    "openai-codex/gpt-5.6-sol",
    "xai/grok-4.6",
    "fireworks/accounts/fireworks/routers/kimi-k3-fast",
    "zai-coding-cn/glm-5.3",
    "fireworks/accounts/fireworks/models/deepseek-v4-flash-0731",
    "openai-codex/gpt-5.6-luna",
    "zai-coding-cn/glm-5.3-flash",
    "zenmux/claude-fable-5-1:google-vertex",
    "akile-claude/claude-fable-5-1",
    "akile-gpt/gpt-5.3-codex-spark",
    "openai-codex/gpt-6-astra"
  ],
  "tokenSpeed": {
    "tpsSlow": 0,
    "tpsMedium": 30,
    "tpsFast": 60,
    "tpsBlazing": 90,
    "display": "tps",
    "useProviderTokens": true,
    "slidingWindow": 1500,
    "countStrategy": "estimate",
    "endTpsBehavior": "average"
  },
  "contextPrune": {
    "enabled": true,
    "showPruneStatusLine": false,
    "summarizerModel": "akile-gpt/gpt-5.3-codex-spark",
    "summarizerThinking": "low",
    "pruneOn": "agent-message",
    "batchingMode": "agent-message",
    "quietOversizedSkips": true,
    "minBatchChars": 8000,
    "recoveryGraceTurns": 3,
    "summarizerIdleTimeoutMs": 20000,
    "summarizerMaxTimeoutMs": 100000,
    "protectedTools": [
      "ask_user_question",
      "planmode",
      "Agent",
      "get_subagent_result",
      "web_search",
      "source_check",
      "get_search_content"
    ],
    "protectedPaths": [
      "**/skills/**/*.md"
    ],
    "chainCompression": {
      "enabled": false,
      "rollingWindow": 3,
      "stripFinalAssistantThinking": true,
      "fuseRangeSummary": true
    },
    "purgeErrors": {
      "enabled": true,
      "cooldownTurns": 2,
      "minArgChars": 500
    },
    "dedupByContentHash": true,
    "autoBudgetThreshold": null,
    "spillThreshold": 16384,
    "spillPreviewBytes": 2048,
    "budgetTurnDelta": null,
    "frontierGapThresholdTokens": null
  },
  "editorPaddingX": 1,
  "fullscreenCopyOnSelect": false,
  "enableSkillCommands": false
}
